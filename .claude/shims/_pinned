#!/usr/bin/env bash
# Run flutter or dart at the version the repo pins in .fvmrc, so /verify never checks a repo
# with the wrong SDK. verify.sh puts this folder first on PATH.
#   _pinned <flutter|dart> <args...>
set -euo pipefail
tool="${1:?tool}"; shift
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

pin="" d="$PWD"
while [[ "$d" != "/" && -n "$d" ]]; do
  if [[ -f "$d/.fvmrc" ]]; then
    pin="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("flutter",""))' "$d/.fvmrc")"
    break
  fi
  d="$(dirname "$d")"
done

# The real binary: the first one on PATH that is not this shim.
real() { local p IFS=:; for p in $PATH; do [[ "$p" != "$here" && -x "$p/$1" ]] && { echo "$p/$1"; return; }; done; }

if [[ -n "$pin" ]] && command -v fvm >/dev/null 2>&1; then exec fvm "$tool" "$@"; fi

bin="$(real "$tool")"
[[ -n "$bin" ]] || { echo "$tool: not installed" >&2; exit 127; }
if [[ -n "$pin" ]]; then
  flutter_bin="$(real flutter)"
  have="$("$flutter_bin" --version --machine 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("frameworkVersion",""))' 2>/dev/null || true)"
  if [[ "$have" != "$pin" ]]; then
    echo "this repo pins Flutter $pin in .fvmrc, but Flutter ${have:-?} is installed and fvm is not." >&2
    echo "install fvm (https://fvm.app), then run 'fvm install' in the repo." >&2
    exit 127
  fi
fi
exec "$bin" "$@"
