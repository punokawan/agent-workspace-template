{
  "verify": {
    "quick": [
      {
        "name": "vet",
        "cmd": [
          "go",
          "vet",
          "./..."
        ],
        "requires": [
          "go.mod"
        ],
        "requires_tool": "go"
      },
      {
        "name": "fmt-check",
        "cmd": [
          "bash",
          "-c",
          "test -z \"$(gofmt -l .)\""
