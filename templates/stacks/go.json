        "requires": [
          "go.mod"
        ],
        "requires_tool": "go"
      }
    ],
    "full": [
      {
        "name": "build",
        "cmd": [
          "go",
          "build",
          "./..."
        ],
        "requires": [
          "go.mod"
        ],
        "requires_tool": "go"
      },
      {
        "name": "test",
        "cmd": [
          "go",
          "test",
          "./..."
        ],
        "requires": [
          "go.mod"
        ],
        "requires_tool": "go"
      }
    ]
  },
